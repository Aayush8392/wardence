diff --git a/helpers/index.js b/helpers/index.js
index 348e785..66079f0 100644
--- a/helpers/index.js
+++ b/helpers/index.js
@@ -82,6 +82,38 @@
     }.bind({res: res}));
   }
 
+  /* Public: safely turns a `request` callback's (error, body) pair into
+   * either an error or parsed data. NEVER throws.
+   *
+   * Why this exists: every JSON.parse(body) in this app used to run
+   * inside an async `request` callback with no try/catch. When an
+   * upstream service is unreachable, `request` invokes the callback with
+   * error set and body === undefined -- JSON.parse(undefined) then
+   * throws "SyntaxError: Unexpected token u" from inside an EventEmitter,
+   * where Express's error middleware cannot reach it. That is an
+   * UNCAUGHT exception, so the whole Node process exits(1) and the
+   * entire storefront goes down because one backend blipped.
+   *
+   * Returns: {err: Error|null, data: parsed|null}
+   */
+  helpers.parseUpstream = function(error, body) {
+    if (error) {
+      return { err: error, data: null };
+    }
+    if (body === undefined || body === null || body === "") {
+      return { err: new Error("Upstream returned an empty body (service unreachable)"), data: null };
+    }
+    // Some callers use request's `json: true`, which pre-parses for us.
+    if (typeof body === "object") {
+      return { err: null, data: body };
+    }
+    try {
+      return { err: null, data: JSON.parse(body) };
+    } catch (e) {
+      return { err: new Error("Upstream returned a non-JSON body: " + String(body).slice(0, 200)), data: null };
+    }
+  }
+
