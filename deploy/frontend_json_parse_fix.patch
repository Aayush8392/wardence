diff --git a/server.js b/server.js
index 929f7a4..a7797bd 100644
--- a/server.js
+++ b/server.js
@@ -16,6 +16,25 @@ var request      = require("request")
   , app          = express()
 
 
+/* Last-resort safety net (Wardence patch).
+ *
+ * Express's error middleware can only catch throws on the synchronous
+ * request path. A throw inside an async `request` callback is an
+ * UNCAUGHT exception, and Node's default behaviour is to exit the
+ * process -- so one unreachable backend service used to take the entire
+ * storefront down, not just the one route that depends on it.
+ *
+ * The individual call sites are now guarded (see helpers.parseUpstream),
+ * so this should never fire. It exists so that any instance we have NOT
+ * found degrades to "one request fails" instead of "whole site down".
+ * Deliberately does not exit: this app holds no cross-request state in
+ * process (sessions live in redis), so continuing is safe here.
+ */
+process.on("uncaughtException", function (err) {
+  console.error("UNCAUGHT EXCEPTION (process kept alive by Wardence patch):",
+                err && err.stack ? err.stack : err);
+});
+
 app.use(helpers.rewriteSlash);
 app.use(metrics);
 app.use(express.static("public"));
