# systemd unit for operator_api.py on the Oracle host -- real process
# supervision, since a bare `uvicorn` process (the decided placement,
# 2026-08-23: NOT an in-cluster pod, no k8s-native self-healing) has
# nothing else restarting it on crash.
#
# NOT yet installed anywhere -- this is a template. Real values needed
# before use (all currently placeholders):
#   - <WARDENCE_USER>: the real Linux user this should run as (never root)
#   - <REPO_PATH>: real absolute path to the cloned repo on the Oracle host
#   - <VENV_PATH>: real absolute path to the Python venv with dependencies
#     installed (kubernetes client, fastapi, uvicorn, etc. -- see
#     p3_trust_action/requirements.txt)
#   - CORS_ORIGINS / PROMETHEUS_URL: real values, only knowable once
#     Vercel (frontend) and the Prometheus NodePort
#     (patch_prometheus_nodeport.sh) both actually exist
#
# Venv/Python pinning risk (2026-08-23, Qwen review 63): a bare `apt
# upgrade`/`dnf update` on the host can silently bump the system Python
# or a shared library (e.g. openssl, breaking pyjwt/requests) out from
# under a venv that was built against the old version, causing this
# service to fail on its next restart with no code change on our side.
# Mitigation: build <VENV_PATH> with a pinned Python (pyenv or an
# explicit `python3.X -m venv`, not `python3 -m venv` against whatever
# the system default happens to be), and re-run `pip install -r
# requirements.txt` after any host-level Python/openssl upgrade rather
# than assuming the existing venv still works.
#
# Secrets are NOT set here -- both real .env files (repo-root .env for
# LLM provider keys, p3_trust_action/.env for R2 credentials) are loaded
# by the Python code itself (model_backend.py / publish_to_r2.py), so they
# just need to exist as real files on this host with real values, same as
# on the current WSL2 dev machine. Never put secret values directly in
# this unit file -- it's committed to the repo.
#
# Install:
#   sudo cp deploy/operator-api.service /etc/systemd/system/wardence-operator-api.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now wardence-operator-api

[Unit]
Description=Wardence Operator API
After=network-online.target k3s.service
Wants=network-online.target

[Service]
Type=simple
User=<WARDENCE_USER>
WorkingDirectory=<REPO_PATH>/p3_trust_action
Environment=CORS_ORIGINS=<REAL_VERCEL_DOMAIN>
Environment=PROMETHEUS_URL=http://localhost:30090
# Persistent, non-tmpfs state dir (2026-08-23, Qwen review 63) -- /tmp on
# this host may be cleaned by systemd-tmpfiles based on file age, which
# could delete a stuck episode's stop/evidence file out from under it.
# Must exist and be owned by <WARDENCE_USER> before first start:
#   sudo mkdir -p /var/lib/wardence/state && sudo chown <WARDENCE_USER> /var/lib/wardence/state
Environment=WARDENCE_STATE_DIR=/var/lib/wardence/state
Environment=KUBECONFIG=/home/ubuntu/.kube/config
# Per-environment durability-window overrides (2026-08-2x) -- real
# recovery timing differs by hardware (confirmed: crash-loop/carts
# ~103-111s here vs. ~30s on the original WSL2/x86 dev machine, against
# a shared 120s default in verifier.py's DURABILITY_WINDOWS). Uncomment
# and set per class ONLY once that class's real recovery time has
# actually been measured on this host -- do not guess ahead of real
# data. See wardence_buildlog.md's matching session for the full
# reasoning and the env var name for every other class.
Environment=DURABILITY_WINDOW_CRASH_LOOP_S=180
Environment=FRONT_END_IMAGE_BASELINE=ghcr.io/aayush8392/front-end:0.3.12-arm64
ExecStart=<VENV_PATH>/bin/uvicorn operator_api:app --host 0.0.0.0 --port 8002
Restart=on-failure
RestartSec=5
# Real gotcha already hit once in this project (2026-08-22 session, WSL2/
# Python 3.14): `--app-dir` reproducibly crashed uvicorn on this stack --
# WorkingDirectory + a bare `operator_api:app` (no --app-dir) is the known
# working invocation. Confirm this still holds on the Oracle host's own
# Python version before trusting it blindly -- it was never re-tested
# outside the original WSL2 environment.

[Install]
WantedBy=multi-user.target
